<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>
	<groupId>com.sskings</groupId>
	<artifactId>agendai</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>agendai</name>
	<description>Agendaí — agendamento online para pequenos negócios</description>

	<properties>
		<java.version>17</java.version>
		<!-- vazio por padrão: o JaCoCo preenche no verify; sem isso, quem roda sem ele (PIT) recebe "@{argLine}" literal -->
		<argLine></argLine>
		<springdoc.version>3.2.0</springdoc.version>
		<archunit.version>1.5.1</archunit.version>
		<!--
			Versões acima das que o Spring Boot gerencia, para corrigir CVEs. Remova cada linha quando o Boot passar a
			trazer uma versão igual ou maior. Jackson 2: só o swagger-core (springdoc) ainda usa; o app usa o Jackson 3.
		-->
		<jackson-2-bom.version>2.21.8</jackson-2-bom.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Dados temporários e compartilhados entre instâncias: limite por IP, depois reservas e cache (ADR-007) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.6.2</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- Dev: `./mvnw spring-boot:run` sobe PostgreSQL e Redis do compose.yaml sozinho (não entra no jar) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Boot 4: um starter de teste por tecnologia (cada um traz o spring-boot-starter-test) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Serviços de verdade nos testes (PostgreSQL e Redis em containers), nunca H2 nem mocks de infraestrutura -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Fronteiras entre módulos verificadas por teste (ADR-001) -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<!-- Testes sempre com a JVM em UTC, como no CI e no servidor -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -Duser.timezone=UTC</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.16</version>
				<configuration>
					<excludes>
						<!-- Única exceção (docs/testes.md): só chama SpringApplication.run; o contexto é testado inteiro -->
						<exclude>com/sskings/agendai/AgendaiApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<execution>
						<!-- mvn verify falha se a cobertura não for 100% (linhas e ramos) — ADR-004 -->
						<id>check</id>
						<goals><goal>check</goal></goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>1.00</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>1.00</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Teste de mutação: ./mvnw test-compile pitest:mutationCoverage. Mínimo de 95% no domínio e na segurança
				     (docs/testes.md); o CI roda em todo PR. As regras de auth dependem do banco: a mutação delas roda com os
				     testes de integração do pacote (Testcontainers, alguns minutos); os de integração de security ficam de
				     fora (cobertos pelos testes de unidade, que são o alvo da mutação ali). -->
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.30.2</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.3</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>com.sskings.agendai.security.*</param>
						<param>com.sskings.agendai.auth.*</param>
						<param>com.sskings.agendai.catalog.*</param>
						<param>com.sskings.agendai.tenant.TenantAccess</param>
						<param>com.sskings.agendai.config.ProductionConfigValidator*</param>
					</targetClasses>
					<targetTests>
						<param>com.sskings.agendai.security.*Test</param>
						<param>com.sskings.agendai.auth.*Test</param>
						<param>com.sskings.agendai.catalog.*Test</param>
						<param>com.sskings.agendai.config.ProductionConfigValidatorTest</param>
					</targetTests>
					<excludedTestClasses>
						<param>com.sskings.agendai.security.*IntegrationTest</param>
					</excludedTestClasses>
					<mutators><mutator>STRONGER</mutator></mutators>
					<outputFormats><param>HTML</param><param>XML</param></outputFormats>
					<timestampedReports>false</timestampedReports>
					<threads>4</threads>
					<mutationThreshold>95</mutationThreshold>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
