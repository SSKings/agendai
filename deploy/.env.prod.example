# Copie para .env.prod (NUNCA versione o .env.prod) e preencha. A API se recusa a subir com valores ausentes,
# fracos ou de exemplo (ProductionConfigValidator).

# ---- Banco: três usuários (privilégio mínimo; a API não ignora o RLS — ADR-006) ----
DATABASE_NAME=agendai
# superusuário: só cria o banco e os papéis; a API nunca recebe esta senha.   openssl rand -base64 24
DATABASE_ADMIN_USERNAME=postgres
DATABASE_ADMIN_PASSWORD=
# dono das tabelas: só as migrações (Flyway) usam
DATABASE_MIGRATION_USERNAME=agendai_owner
DATABASE_MIGRATION_PASSWORD=
# aplicação: só lê e grava dados (sem CREATE/ALTER/DROP, sem BYPASSRLS)
DATABASE_USERNAME=agendai_app
DATABASE_PASSWORD=

# ---- Redis (limite por IP; depois reservas e cache): 16+ caracteres ----   openssl rand -hex 24
REDIS_PASSWORD=

# ---- RabbitMQ (eventos: outbox → worker de e-mail) ----   openssl rand -hex 24
RABBITMQ_USERNAME=agendai
RABBITMQ_PASSWORD=

# ---- Segredo dos access tokens (JWT) ----   openssl rand -base64 48
JWT_SECRET=

# ---- Front-end: origem exata, https ----
CORS_ALLOWED_ORIGINS=https://agendai.seudominio.com.br
