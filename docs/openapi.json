{
  "components" : {
    "schemas" : {
      "AuthResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserView"
          }
        },
        "required" : [ "accessToken", "user" ],
        "type" : "object"
      },
      "ChangePasswordRequest" : {
        "properties" : {
          "currentPassword" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "newPassword" : {
            "minLength" : 1,
            "pattern" : "^(?=.*\\p{L})(?=.*\\d).{8,72}$",
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 150,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "tenants" : {
            "items" : {
              "$ref" : "#/components/schemas/TenantView"
            },
            "type" : "array"
          }
        },
        "required" : [ "email", "id", "name", "tenants" ],
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "businessName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^[^\\p{Cntrl}\\u2028\\u2029]*$",
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 150,
            "minLength" : 0,
            "pattern" : "^[\\x21-\\x7E]+$",
            "type" : "string"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^[^\\p{Cntrl}\\u2028\\u2029]*$",
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "pattern" : "^(?=.*\\p{L})(?=.*\\d).{8,72}$",
            "type" : "string"
          }
        },
        "required" : [ "businessName", "email", "name", "password" ],
        "type" : "object"
      },
      "TenantView" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "OWNER", "PROFESSIONAL" ],
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "timeZone" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "role", "slug", "timeZone" ],
        "type" : "object"
      },
      "UserView" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "id", "name" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "agendai_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "X-Requested-With",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me-controller" ]
      }
    },
    "/api/me/password" : {
      "put" : {
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/tenants/{id}" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TenantView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "tenant-controller" ]
      }
    }
  }
}
